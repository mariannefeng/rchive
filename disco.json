{
  "version": "1.0",
  "services": {
    "web": {
      "port": 8080,
      "volumes": [
        {
          "name": "data",
          "destinationPath": "/app/volume"
        },
        {
          "name": "git",
          "destinationPath": "/app/mount/git"
        },
        {
          "name": "config",
          "destinationPath": "/app/mount/config"
        },
        {
          "name": "ssh",
          "destinationPath": "/app/mount/ssh"
        }
      ]
    }
  }
}
