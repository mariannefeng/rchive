{
  "version": "1.0",
  "services": {
    "web": {
      "port": 8000,
      "volumes": [
        {
          "name": "data",
          "destinationPath": "/app/volume"
        }
      ]
    },
    "hook:deploy:start:before": {
      "type": "command",
      "command": "mkdir /app/volume/ssh",
      "volumes": [
        {
          "name": "data",
          "destinationPath": "/app/volume"
        }
      ]
    }
  }
}
